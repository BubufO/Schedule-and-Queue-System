# Copy this file to backend/.env and fill in your Supabase connection string.
# In Supabase: project > Connect > Session pooler, and replace [YOUR-PASSWORD].
# The .env file is git-ignored, so the password never gets committed.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
